|hold_controller
Clock => hold_used~reg0.CLK
Clock => hold_valid~reg0.CLK
Clock => held_piece_id[0]~reg0.CLK
Clock => held_piece_id[1]~reg0.CLK
Clock => held_piece_id[2]~reg0.CLK
Clock => request_next_piece~reg0.CLK
Clock => load_piece~reg0.CLK
Clock => piece_to_load[0]~reg0.CLK
Clock => piece_to_load[1]~reg0.CLK
Clock => piece_to_load[2]~reg0.CLK
Clock => state~4.DATAIN
Resetn => state.OUTPUTSELECT
Resetn => state.OUTPUTSELECT
Resetn => state.OUTPUTSELECT
Resetn => piece_to_load.OUTPUTSELECT
Resetn => piece_to_load.OUTPUTSELECT
Resetn => piece_to_load.OUTPUTSELECT
Resetn => load_piece.OUTPUTSELECT
Resetn => request_next_piece.OUTPUTSELECT
Resetn => held_piece_id.OUTPUTSELECT
Resetn => held_piece_id.OUTPUTSELECT
Resetn => held_piece_id.OUTPUTSELECT
Resetn => hold_valid.OUTPUTSELECT
Resetn => hold_used.OUTPUTSELECT
hold_request => always0.IN1
piece_locked => hold_used.OUTPUTSELECT
current_piece_id[0] => held_piece_id.DATAB
current_piece_id[0] => Equal0.IN2
current_piece_id[1] => held_piece_id.DATAB
current_piece_id[1] => Equal0.IN1
current_piece_id[2] => held_piece_id.DATAB
current_piece_id[2] => Equal0.IN0
next_piece_id[0] => Selector4.IN1
next_piece_id[1] => Selector3.IN1
next_piece_id[2] => Selector2.IN1
piece_to_load[0] << piece_to_load[0]~reg0.DB_MAX_OUTPUT_PORT_TYPE
piece_to_load[1] << piece_to_load[1]~reg0.DB_MAX_OUTPUT_PORT_TYPE
piece_to_load[2] << piece_to_load[2]~reg0.DB_MAX_OUTPUT_PORT_TYPE
load_piece << load_piece~reg0.DB_MAX_OUTPUT_PORT_TYPE
request_next_piece << request_next_piece~reg0.DB_MAX_OUTPUT_PORT_TYPE
held_piece_id[0] << held_piece_id[0]~reg0.DB_MAX_OUTPUT_PORT_TYPE
held_piece_id[1] << held_piece_id[1]~reg0.DB_MAX_OUTPUT_PORT_TYPE
held_piece_id[2] << held_piece_id[2]~reg0.DB_MAX_OUTPUT_PORT_TYPE
hold_valid << hold_valid~reg0.DB_MAX_OUTPUT_PORT_TYPE
hold_used << hold_used~reg0.DB_MAX_OUTPUT_PORT_TYPE


