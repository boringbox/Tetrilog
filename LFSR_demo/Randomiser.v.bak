/*
Code: https://en.wikipedia.org/wiki/Tetromino
Piece[1] = I block 
Piece[2] = O Block
Piece[3] = T Block
Piece[4] = J Block
Piece[5] = L Block
Piece[6] = S Block
Piece[7] = Z Block 
*/ 

module Randomiser(Clock, Resetn, NextBlock, Piece, LEDR);
    parameter [2:0] PIECE_I = 3'd1; 
    parameter [2:0] PIECE_O = 3'd2;
    parameter [2:0] PIECE_T = 3'd3;
    parameter [2:0] PIECE_J = 3'd4;
    parameter [2:0] PIECE_L = 3'd5;
    parameter [2:0] PIECE_S = 3'd6;
    parameter [2:0] PIECE_Z = 3'd7;

    input Clock;
    input Resetn;          
    input NextBlock; // 1-clock pulse: step to the next piece
    output reg [2:0] Piece;
    output [9:0] LEDR;
    
    

    wire[15:0] rando;
    LFSR_16bit RNG1 (Resetn, Clock, rando);

    assign LEDR = 10'b0000000001 << Piece; 
    
    always @(posedge Clock)
    begin
        if (Resetn == 1'b0)
            Piece <= PIECE_I;
        else if (NextBlock == 1'b1)
        begin
            Piece <= (rando % 7) + 1; // Logic similar to C: Generate a random number between 0 and 6 then add 1 
                                      // Get the code that we want 1-7;
        end
    end
endmodule 


module LFSR_16bit #(parameter initial_seed = 16'hECE0) (
    input wire resetn,
    input wire clock,
    output reg[15:0] rando
);
    wire next_bit; 
    assign next_bit = (((rando[15] ^ rando[14]) ^ rando[12]) ^  rando[3]);

    always@(posedge clock)
    begin
        if(resetn == 1'b0)
        begin
            rando <= initial_seed; // Resets the LFSR, NOT THE PIECE VALUE 
        end 
        else
        begin 
            rando <= {rando[14:0], next_bit};
        end 
    end
endmodule
